#include <stdio.h>
#include <stdlib.h>

// Board represented as a 3x3 array
char board[3][3];

// Initialize the board with numbers 1-9
void init_board() {
    char num = '1';
    for (int i = 0; i < 3; i++)
        for (int j = 0; j < 3; j++)
            board[i][j] = num++;
}

// Display the current board
void print_board() {
    printf("\n");
    printf(" %c | %c | %c \n", board[0][0], board[0][1], board[0][2]);
    printf("---|---|---\n");
    printf(" %c | %c | %c \n", board[1][0], board[1][1], board[1][2]);
    printf("---|---|---\n");
    printf(" %c | %c | %c \n", board[2][0], board[2][1], board[2][2]);
    printf("\n");
}

// Check if a player has won
// Returns 1 if player has won, 0 otherwise
int check_win(char player) {
    // Check rows
    for (int i = 0; i < 3; i++)
        if (board[i][0] == player && board[i][1] == player && board[i][2] == player)
            return 1;

    // Check columns
    for (int j = 0; j < 3; j++)
        if (board[0][j] == player && board[1][j] == player && board[2][j] == player)
            return 1;

    // Check diagonals
    if (board[0][0] == player && board[1][1] == player && board[2][2] == player)
        return 1;
    if (board[0][2] == player && board[1][1] == player && board[2][0] == player)
        return 1;

    return 0;
}

// Check if the board is full (draw)
int check_draw() {
    for (int i = 0; i < 3; i++)
        for (int j = 0; j < 3; j++)
            if (board[i][j] != 'X' && board[i][j] != 'O')
                return 0;
    return 1;
}

// Make a move: place player's symbol at chosen position (1-9)
// Returns 1 if valid move, 0 if cell is already taken or invalid
int make_move(int pos, char player) {
    if (pos < 1 || pos > 9) {
        printf("Invalid position! Choose between 1 and 9.\n");
        return 0;
    }

    int row = (pos - 1) / 3;
    int col = (pos - 1) % 3;

    if (board[row][col] == 'X' || board[row][col] == 'O') {
        printf("Cell already taken! Choose another.\n");
        return 0;
    }

    board[row][col] = player;
    return 1;
}

// Play a two-player game
void play_game() {
    int pos, moves = 0;
    char current_player = 'X';

    init_board();

    printf("=== TIC TAC TOE ===\n");
    printf("Player 1: X   Player 2: O\n");
    printf("Enter the cell number (1-9) to place your mark:\n");
    printf("\n 1 | 2 | 3 \n---|---|---\n 4 | 5 | 6 \n---|---|---\n 7 | 8 | 9 \n");

    while (1) {
        print_board();
        printf("Player %c's turn. Enter position (1-9): ", current_player);

        if (scanf("%d", &pos) != 1) {
            printf("Invalid input! Enter a number.\n");
            // Clear invalid input
            while (getchar() != '\n');
            continue;
        }

        if (!make_move(pos, current_player))
            continue;

        moves++;

        if (check_win(current_player)) {
            print_board();
            printf("*** Player %c wins! Congratulations! ***\n", current_player);
            return;
        }

        if (check_draw()) {
            print_board();
            printf("*** It's a draw! Well played! ***\n");
            return;
        }

        // Switch player
        current_player = (current_player == 'X') ? 'O' : 'X';
    }
}

int main() {
    char again;

    do {
        play_game();

        printf("\nPlay again? (y/n): ");
        scanf(" %c", &again);
    } while (again == 'y' || again == 'Y');

    printf("Thanks for playing!\n");
    return 0;
}
